{
  "name": "wotb-mod-manager",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "cross-env DEBUG=0 vite",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "tauri": "tauri",
    "bump": "node bump-version.cjs",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:format": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "check:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "verify": "pnpm lint && pnpm test:run && pnpm build && pnpm check:test && pnpm check:format && pnpm check:clippy"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-dialog": "2.3",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "^1.9.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/types": "^2.0.0",
    "@pinia/testing": "^1.0.2",
    "@tailwindcss/vite": "^4.1.10",
    "@tauri-apps/cli": "^2.3.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.29.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-vue": "^10.2.0",
    "jsdom": "^29.1.1",
    "lodash-es": "^4.17.21",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^20.0.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.0.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.0"
  }
}
