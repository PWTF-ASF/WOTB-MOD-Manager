{
  "$schema": "../gen/schemas/desktop-capability.json",
  "identifier": "default",
  "description": "基础运行能力配置",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "shell:default",
    "shell:allow-spawn",
    "fs:default",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    "allow-my-commands"
  ]
}